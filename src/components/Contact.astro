<section id="contact" class="section contact">
  <div class="container">
    <div class="section-header">
      <h2>Contact</h2>
      <p>Please feel free to reach out to me through GitHub or LinkedIn.</p>
    </div>
    <div class="contact-card">
      <!-- <a href="mailto:your.email@example.com">your.email@example.com</a> -->
      <a href="https://github.com/g2116201" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/a0409202501g/?isSelfProfile=true" target="_blank" rel="noreferrer">LinkedIn</a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--navy);
    color: var(--white);
  }

  .contact .section-header p {
    color: rgba(255, 255, 255, 0.75);
  }

  .contact-card {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .contact-card a {
    background: var(--white);
    color: var(--navy);
    padding: 0.85rem 1.2rem;
    border-radius: 12px;
    font-weight: 600;
  }

  .contact-card a:hover,
  .contact-card a:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 3px;
  }
</style>
